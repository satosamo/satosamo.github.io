---
layout: layouts/base.njk
---
{% if node.isRoot %}
  <section class="hero">
    <h1 class="hero-title">{{ site.title }}</h1>
  </section>
{% else %}
  <nav class="crumbs" aria-label="Breadcrumb">
    {% for c in node.breadcrumbs %}<a href="{{ c.url }}">{{ c.title }}</a><span class="crumb-sep" aria-hidden="true">/</span>{% endfor %}<span aria-current="page">{{ node.title }}</span>
  </nav>
  <section class="section-head">
    <div class="section-titlebar">
      {% if node.about %}
      <a class="course-title course-title-link" href="{{ node.about.url }}" aria-label="{{ node.title }} — About">
        <h1>{{ node.title }}</h1>
        <span class="course-title-label" aria-hidden="true">About</span>
      </a>
      {% elif node.course %}
      <div class="course-title"><h1>{{ node.title }}</h1></div>
      {% else %}
      <h1>{{ node.title }}</h1>
      {% endif %}
      {% if node.courses != none %}
      <span class="chip">{{ node.courses }} course{% if node.courses != 1 %}s{% endif %}</span>
      {% else %}
      <span class="chip">{{ node.count }} page{% if node.count != 1 %}s{% endif %}</span>
      {% endif %}
    </div>
    {% if node.blurb %}<p class="section-meta"><span class="chip">{{ node.blurb }}</span></p>{% endif %}
  </section>
{% endif %}

{% macro homeTile(item, cls, mark) %}
  <a class="tile {{ cls }}" href="{{ item.url }}">
    {% if mark %}<span class="tile-eyebrow">{{ mark }}</span>{% endif %}
    <span class="tile-title">{{ item.title }}</span>
    {% if item.thesisTitle %}<span class="tile-thesis-title">{{ item.thesisTitle }}</span>{% endif %}
    {% if item.glyph %}
    <span class="tile-glyph" aria-hidden="true">
      {%- include "glyphs/" + item.glyph + ".svg" ignore missing -%}
    </span>
    {% endif %}
  </a>
{% endmacro %}

{% if node.home %}
<div class="home">
  {% if node.home.quickAccess.length %}
  <div class="home-quick">
    <span class="home-quick-label" aria-hidden="true">Quick Access</span>
    <nav class="home-quick-items" aria-label="Quick Access">
      {% for item in node.home.quickAccess %}{{ homeTile(item, "home-quick-item") }}{% endfor %}
    </nav>
  </div>
  {% endif %}

  {% if node.home.theses.length %}
  <p class="home-label">{% if node.home.theses.length > 1 %}Theses{% else %}Thesis{% endif %}</p>
  {% for item in node.home.theses %}{{ homeTile(item, "home-thesis") }}{% endfor %}
  {% endif %}

  {% if node.home.fields.length %}
  <p class="home-label">Fields</p>
  <div class="home-fields">
    {% for item in node.home.fields %}{{ homeTile(item, "home-field", (loop.index | string).padStart(2, "0")) }}{% endfor %}
  </div>
  {% endif %}

  {% if node.home.other %}
  {{ homeTile(node.home.other, "home-other") }}
  {% endif %}
</div>
{% elif node.items.length %}
<div class="lattice">
  {% for item in node.items %}
    {% if item.kind == "break" %}
    <div class="lattice-break"></div>
    {%- elif node.about and item.slug == "about" and item.kind == "article" -%}
    {%- else -%}
      {% set bare = item.kind == "section" and item.slug in ["articles", "coursework"] %}
      <a class="tile" href="{{ item.url }}">
        <span class="tile-eyebrow">
          {%- if item.draft -%}Draft · {% endif -%}
          {%- if item.kind == "section" -%}
            {% if item.course %}Course · {% elif not bare %}Section · {% endif %}
            {%- if item.courses != none -%}
              {{ item.courses }} course{% if item.courses != 1 %}s{% endif %}
            {%- else -%}
              {{ item.count }} page{% if item.count != 1 %}s{% endif %}
            {%- endif -%}
          {%- elif item.kind == "pdf" -%}
            PDF
          {%- else -%}
            Article
          {%- endif -%}
        </span>
        <span class="tile-title">{{ item.title }}</span>
        {% if item.summary and not bare %}<span class="tile-summary">{{ item.summary }}</span>{% endif %}
        {% if item.glyph %}
        <span class="tile-glyph" aria-hidden="true">
          {%- include "glyphs/" + item.glyph + ".svg" ignore missing -%}
        </span>
        {% endif %}
      </a>
    {% endif %}
  {% endfor %}
</div>
{% else %}
<p class="empty">Nothing here yet — add a markdown file under <code>src/content/{{ node.path }}</code> to begin.</p>
{% endif %}
